local function BurstFarm(remote, args, damageRemote, humanoid, burstSize, burstDelay, loopCount)
    for _ = 1, burstSize do
        for i = 1, loopCount do
            pcall(function() 
                if remote then remote:FireServer(unpack(args)) end
                if damageRemote and humanoid then damageRemote:FireServer(humanoid, 15, false) end
            end)
        end
        task.wait(burstDelay) 
    end
end

function AutoDumbbell()
    _G.StopDumbbell = false
    task.spawn(function()
        while _G.AutoDumbbell and not _G.StopDumbbell do
            local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Equipment")
            local args = {"Workout", {Name = "Dumbbell"}}
            for i = 1, 55 do
                for j = 1, 10 do
                    for _ = 1, 10 do
                        task.spawn(function()
                            remote:FireServer(unpack(args))
                            remote:FireServer(unpack(args))
                            remote:FireServer(unpack(args))
                        end)
                    end
                end
                task.wait(0)
            end
        end
    end)
end

